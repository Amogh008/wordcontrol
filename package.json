{
  "name": "wordcontrol-api",
  "version": "1.0.0",
  "description": "REST API backing the Wordcontrol app's word list, stored in MongoDB.",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "ENV_FILE=.env.production node src/server.js",
    "dev": "ENV_FILE=.env.development nodemon src/server.js",
    "local": "ENV_FILE=.env.development nodemon src/server.js",
    "clone-db:dev": "node scripts/cloneDatabasesToDev.js",
    "rollback-db:prod-to-v5": "node scripts/rollbackProductionToV5.js --execute",
    "migrate:language-profiles": "node scripts/migrateLanguageProfiles.js",
    "migrate:friendships": "node scripts/migrateFriendshipsToUser.js --execute",
    "migrate:language-profiles-to-user": "node scripts/migrateLanguageProfilesToUser.js --execute",
    "drop-legacy:language-profiles-and-friendships": "node scripts/dropLegacyLanguageAndFriendshipCollections.js --execute",
    "backfill:user-preferences": "node scripts/backfillUserPreferences.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cassandra-driver": "^4.9.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "google-auth-library": "^10.9.0",
    "groq-sdk": "^1.4.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.8.3",
    "morgan": "^1.11.0",
    "nodemailer": "^9.0.3",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "@flydotio/dockerfile": "^0.7.10",
    "nodemon": "^3.1.7"
  },
  "private": true
}
